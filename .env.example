# NetFusion Environment Configuration Template

# Server Settings
PORT=8080
HOST=0.0.0.0
ENV=development
LOG_LEVEL=INFO

# Database Connection
# Supported: "postgres" or "sqlite"
DB_DRIVER=postgres
DATABASE_URL=postgres://postgres:postgrespassword@localhost:5432/netfusion?sslmode=disable
DB_MAX_CONNS=25

# Network Engine Settings
# Set SIMULATION_MODE=true for testing without multiple physical interfaces
SIMULATION_MODE=false
TELEMETRY_INTERVAL_MS=1000
RETENTION_DAYS=7
